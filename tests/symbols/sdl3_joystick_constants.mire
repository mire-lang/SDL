load sdl::sdl3::joystick
load! /tests/_support/harness

@[test]
pub fn joystick_type_unknown_success: () :bool {
    return use! harness::check("joystick::type_unknown", joystick::type_unknown() == 0)
}

@[test]
pub fn joystick_type_gamepad_success: () :bool {
    return use! harness::check("joystick::type_gamepad", joystick::type_gamepad() == 1)
}

@[test]
pub fn joystick_type_wheel_success: () :bool {
    return use! harness::check("joystick::type_wheel", joystick::type_wheel() == 2)
}

