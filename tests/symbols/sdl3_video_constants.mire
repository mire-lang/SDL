load sdl::sdl3::video
load! /tests/_support/harness

@[test]
pub fn video_window_flag_fullscreen_success: () :bool {
    return use! harness::check("video::window_flag_fullscreen", video::window_flag_fullscreen() == 0x0000000000000001)
}

