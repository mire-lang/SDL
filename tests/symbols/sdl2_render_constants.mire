load sdl::sdl2::render
load! /tests/_support/harness

@[test]
pub fn render_texture_access_static_success: () :bool {
    return use! harness::check("render::texture_access_static", render::texture_access_static() == 0)
}

@[test]
pub fn render_texture_access_streaming_success: () :bool {
    return use! harness::check("render::texture_access_streaming", render::texture_access_streaming() == 1)
}

@[test]
pub fn render_texture_access_target_success: () :bool {
    return use! harness::check("render::texture_access_target", render::texture_access_target() == 2)
}

@[test]
pub fn render_pixel_format_rgba8888_success: () :bool {
    return use! harness::check("render::pixel_format_rgba8888", render::pixel_format_rgba8888() == 372645892)
}

